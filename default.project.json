{
  "name": "SoloProject",
  "tree": {
    "$className": "DataModel",
    "Workspace": {
      "$properties": {
        "StreamingEnabled": true,
        "StreamingMinRadius": 64,
        "StreamingTargetRadius": 180
      }
    },
    "Lighting": {
      "$properties": {
        "Technology": "Voxel"
      }
    },
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Preload": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true,
        "MenuAssets": {
          "$path": "src/preload/MenuAssets"
        }
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      },
      "StarterCharacterScripts": {
        "$path": "src/character"
      }
    },
    "ReplicatedFirst": {
      "$ignoreUnknownInstances": true,
      "Loader": {
        "$path": "src/first"
      }
    }
  }
}