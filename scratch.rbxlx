          <string name="Source"><![CDATA[export type AbilityData = {
	name: string,
	description: string,
	tag: string,
}

export type ClassStats = {
	offense: number,   -- 1 to 5
	defense: number,   -- 1 to 5
	agility: number,   -- 1 to 5
	difficulty: number -- 1 to 5
}

export type EquipmentData = {
	name: string,
	slot: string,
	rarity: string,
	description: string,
	stats: { [string]: string },
}

export type ClassInfo = {
	id: string,
	name: string,
	title: string,
	role: string,
	description: string,
	accentColor: Color3,
	stats: ClassStats,
	abilities: { AbilityData },
	equipment: EquipmentData,
}

