          <Item class="ModuleScript" referent="17">
            <Properties>
              <string name="Name">SoundManager</string>
              <string name="Source"><![CDATA[local SoundService = game:GetService("SoundService")
local Players = game:GetService("Players")

local SoundManager = {}

-- Audio asset IDs (configure with your custom asset IDs when ready)
local Sounds = {
	Hover = "",
	Click = "",
	Select = "",
	Confirm = "",
	Close = "",
	Error = "",
}

local createdSounds: { [string]: Sound } = {}

local function getSound(name: string): Sound?
	local assetId = Sounds[name]
	if not assetId or assetId == "" then return nil end

	if not createdSounds[name] then
		pcall(function()
			local sound = Instance.new("Sound")
			sound.Name = `UISound_{name}`
			sound.SoundId = assetId
			sound.Volume = 0.5
			local player = Players.LocalPlayer
			if player and player:FindFirstChild("PlayerGui") then
				sound.Parent = player.PlayerGui
			else
				sound.Parent = SoundService
			end
			createdSounds[name] = sound
		end)
	end

	return createdSounds[name]
end

function SoundManager.Play(name: string, volumeScale: number?)
	pcall(function()
		local sound = getSound(name)
		if sound and sound.SoundId ~= "" then
			sound.Volume = (volumeScale or 1) * 0.4
			sound:Play()
		end
	end)
end

function SoundManager.PlayHover()
	SoundManager.Play("Hover", 0.3)
end

function SoundManager.PlayClick()
	SoundManager.Play("Click", 0.6)
end

function SoundManager.PlaySelect()
	SoundManager.Play("Select", 0.8)
end

function SoundManager.PlayConfirm()
	SoundManager.Play("Confirm", 1.0)
end

function SoundManager.PlayClose()
	SoundManager.Play("Close", 0.5)
end

return SoundManager
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="18">
            <Properties>
              <string name="Name">TitleScreen</string>
              <string name="Source"><![CDATA[local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local UITheme = require(Shared:WaitForChild("UITheme"))
local SoundManager = require(script.Parent:WaitForChild("SoundManager"))

export type TitleScreenCallbacks = {
	onStartGame: () -> (),
	onOpenSettings: () -> (),
}

local TitleScreen = {}

function TitleScreen.Create(parent: GuiObject, callbacks: TitleScreenCallbacks): CanvasGroup
	local container = Instance.new("CanvasGroup")
	container.Name = "TitleScreen"
	container.Size = UDim2.new(1, 0, 1, 0)
	container.BackgroundTransparency = 1
	container.GroupTransparency = 0
	container.Parent = parent

	-- Cinematic Vignette Overlay
	local vignette = Instance.new("Frame")
	vignette.Name = "Vignette"
	vignette.Size = UDim2.new(1, 0, 1, 0)
	vignette.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	vignette.BackgroundTransparency = 0.4
	vignette.BorderSizePixel = 0
	vignette.Parent = container

	local vignetteGrad = Instance.new("UIGradient")
	vignetteGrad.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.7),
		NumberSequenceKeypoint.new(0.5, 0.2),
		NumberSequenceKeypoint.new(1, 0.7),
	})
	vignetteGrad.Rotation = 90
	vignetteGrad.Parent = vignette

	-- Center Content Area
	local content = Instance.new("Frame")
	content.Name = "Content"
	content.Size = UDim2.new(0, 500, 0, 480)
	content.AnchorPoint = Vector2.new(0.5, 0.5)
	content.Position = UDim2.new(0.5, 0, 0.5, 0)
	content.BackgroundTransparency = 1
	content.Parent = container

	-- Title Header
	local titleLabel = Instance.new("TextLabel")
	titleLabel.Name = "TitleLabel"
	titleLabel.Size = UDim2.new(1, 0, 0, 70)
	titleLabel.Position = UDim2.new(0, 0, 0, 40)
	titleLabel.BackgroundTransparency = 1
	titleLabel.Text = "SANCTUARY"
	titleLabel.TextColor3 = UITheme.Colors.GoldLight
	titleLabel.Font = UITheme.Fonts.Title
	titleLabel.TextSize = 56
	titleLabel.TextStrokeColor3 = Color3.fromRGB(40, 25, 10)
	titleLabel.TextStrokeTransparency = 0.2
	titleLabel.Parent = content

	local subtitleLabel = Instance.new("TextLabel")
	subtitleLabel.Name = "SubtitleLabel"
	subtitleLabel.Size = UDim2.new(1, 0, 0, 24)
	subtitleLabel.Position = UDim2.new(0, 0, 0, 110)
	subtitleLabel.BackgroundTransparency = 1
	subtitleLabel.Text = "CHRONICLES OF ASCENSION"
	subtitleLabel.TextColor3 = UITheme.Colors.TextSecondary
	subtitleLabel.Font = UITheme.Fonts.Tag
	subtitleLabel.TextSize = 14
	subtitleLabel.TextStrokeTransparency = 0.7
	subtitleLabel.Parent = content

	-- Decorative Divider
	local divider = Instance.new("Frame")
	divider.Name = "Divider"
	divider.Size = UDim2.new(0, 240, 0, 2)
	divider.AnchorPoint = Vector2.new(0.5, 0)
	divider.Position = UDim2.new(0.5, 0, 0, 145)
	divider.BackgroundColor3 = UITheme.Colors.Gold
	divider.BorderSizePixel = 0
	divider.Parent = content
	UITheme.AddGradient(divider, UITheme.Colors.GoldLight, UITheme.Colors.GoldDark, 0)

	-- Button Container
	local buttonList = Instance.new("Frame")
	buttonList.Name = "ButtonList"
	buttonList.Size = UDim2.new(1, 0, 0, 200)
	buttonList.Position = UDim2.new(0, 0, 0, 180)
	buttonList.BackgroundTransparency = 1
	buttonList.Parent = content

	local listLayout = Instance.new("UIListLayout")
	listLayout.FillDirection = Enum.FillDirection.Vertical
	listLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	listLayout.SortOrder = Enum.SortOrder.LayoutOrder
	listLayout.Padding = UDim.new(0, 16)
	listLayout.Parent = buttonList

	-- 1. Start Game Button
	local startBtn = Instance.new("TextButton")
	startBtn.Name = "StartButton"
	startBtn.Size = UDim2.new(0, 320, 0, 56)
	startBtn.BackgroundColor3 = UITheme.Colors.Gold
	startBtn.AutoButtonColor = false
	startBtn.Text = "START GAME"
	startBtn.TextColor3 = Color3.fromRGB(20, 15, 10)
	startBtn.Font = UITheme.Fonts.Button
	startBtn.TextSize = 20
	startBtn.LayoutOrder = 1
	startBtn.Parent = buttonList

	UITheme.AddCorner(startBtn, 8)
	local startStroke = UITheme.AddStroke(startBtn, UITheme.Colors.GoldLight, 2, 0)
	UITheme.AddGradient(startBtn, UITheme.Colors.GoldLight, UITheme.Colors.Gold, 90)

	UITheme.MakeButtonInteractive(
		startBtn,
		startStroke,
		UITheme.Colors.GoldLight,
		SoundManager.PlayHover,
		function()
			SoundManager.PlayClick()
			callbacks.onStartGame()
		end
	)

	-- 2. Settings Button
	local settingsBtn = Instance.new("TextButton")
	settingsBtn.Name = "SettingsButton"
	settingsBtn.Size = UDim2.new(0, 320, 0, 50)
	settingsBtn.BackgroundColor3 = UITheme.Colors.Surface
	settingsBtn.AutoButtonColor = false
	settingsBtn.Text = "SETTINGS & KEYBINDS"
	settingsBtn.TextColor3 = UITheme.Colors.TextPrimary
	settingsBtn.Font = UITheme.Fonts.Button
	settingsBtn.TextSize = 16
	settingsBtn.LayoutOrder = 2
	settingsBtn.Parent = buttonList

	UITheme.AddCorner(settingsBtn, 8)
	local settingsStroke = UITheme.AddStroke(settingsBtn, UITheme.Colors.Border, 1.5, 0.3)

	UITheme.MakeButtonInteractive(
		settingsBtn,
		settingsStroke,
		UITheme.Colors.Gold,
		SoundManager.PlayHover,
		function()
			SoundManager.PlayClick()
			callbacks.onOpenSettings()
		end
	)

	-- Version Tag
	local versionLabel = Instance.new("TextLabel")
	versionLabel.Name = "VersionLabel"
	versionLabel.Size = UDim2.new(0, 200, 0, 20)
	versionLabel.Position = UDim2.new(0, 20, 1, -30)
	versionLabel.BackgroundTransparency = 1
	versionLabel.Text = "v0.1.0 • Alpha Build"
	versionLabel.TextColor3 = UITheme.Colors.TextMuted
	versionLabel.Font = UITheme.Fonts.Body
	versionLabel.TextSize = 12
	versionLabel.TextXAlignment = Enum.TextXAlignment.Left
	versionLabel.Parent = container

	return container
end

return TitleScreen
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="19">
            <Properties>
              <string name="Name">UIManager</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local UITheme = require(Shared:WaitForChild("UITheme"))
local SettingsConfig = require(Shared:WaitForChild("SettingsConfig"))
local Network = require(Shared:WaitForChild("Network"))

local function safeRequire(childName: string)
	local child = script.Parent:WaitForChild(childName, 5)
	if not child then
		warn(`[UIManager] Could not find child module: {childName}`)
		return nil
	end
	local ok, res = pcall(function()
		return require(child)
	end)
	if not ok then
		warn(`[UIManager ERROR] Failed requiring {childName}:`, res)
		return nil
	end
	return res
end

local TitleScreen = safeRequire("TitleScreen")
local SettingsModal = safeRequire("SettingsModal")
local ClassSelectionScreen = safeRequire("ClassSelectionScreen")

local LobbyCamera: any = nil
pcall(function()
	LobbyCamera = require(script.Parent.Parent:WaitForChild("LobbyCamera"))
end)

local UIManager = {}

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui") :: PlayerGui

local screenGui: ScreenGui
local titleScreenGroup: CanvasGroup
local settingsModalGroup: CanvasGroup
local classSelectGroup: CanvasGroup

local currentSettings = SettingsConfig.CloneDefaultSettings()

local function fadeCanvas(group: CanvasGroup, targetTrans: number, duration: number?, onComplete: (() -> ())?)
	if not group then return end
	local tween = TweenService:Create(
		group,
		TweenInfo.new(duration or 0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
		{ GroupTransparency = targetTrans }
	)
	if onComplete then
		tween.Completed:Once(function()
			onComplete()
		end)
	end
	tween:Play()
end

function UIManager.Init(onGameStartRequested: (classId: string) -> ())
	screenGui = Instance.new("ScreenGui")
	screenGui.Name = "LobbyScreenGui"
	screenGui.ResetOnSpawn = false
	screenGui.IgnoreGuiInset = true
	screenGui.DisplayOrder = 100
	screenGui.Parent = playerGui

	-- 1. Initialize Title Screen
	if TitleScreen then
		titleScreenGroup = TitleScreen.Create(screenGui, {
			onStartGame = function()
				UIManager.ShowClassSelect()
			end,
			onOpenSettings = function()
				UIManager.ShowSettings()
			end,
		})
	end

	-- 2. Initialize Settings Modal
	if SettingsModal then
		settingsModalGroup = SettingsModal.Create(screenGui, currentSettings, {
			onClose = function()
				UIManager.CloseSettings()
			end,
			onSave = function(newSettings)
				currentSettings = newSettings
				local saveRemote = Network.GetRemoteEvent(Network.Remotes.SaveSettings)
				saveRemote:FireServer(newSettings)
			end,
		})
	end

	-- 3. Initialize Class Selection Screen
	if ClassSelectionScreen then
		classSelectGroup = ClassSelectionScreen.Create(screenGui, {
			onBackToTitle = function()
				UIManager.ShowTitle()
			end,
			onConfirmClass = function(classId: string)
				local selectRemote = Network.GetRemoteEvent(Network.Remotes.SelectClass)
				selectRemote:FireServer(classId)
				onGameStartRequested(classId)
			end,
		})
	end

	-- Start on Title Screen
	if titleScreenGroup then
		titleScreenGroup.Visible = true
		titleScreenGroup.GroupTransparency = 0
	end
end

function UIManager.ShowTitle()
	if settingsModalGroup then
		settingsModalGroup.Visible = false
		settingsModalGroup.GroupTransparency = 1
	end

	if LobbyCamera then
		pcall(function()
			LobbyCamera.StartTitleMode()
		end)
	end

	if classSelectGroup and titleScreenGroup then
		fadeCanvas(classSelectGroup, 1, 0.25, function()
			classSelectGroup.Visible = false
			titleScreenGroup.Visible = true
			fadeCanvas(titleScreenGroup, 0, 0.25)
		end)
	end
end

function UIManager.ShowSettings()
	if settingsModalGroup then
		settingsModalGroup.Visible = true
		fadeCanvas(settingsModalGroup, 0, 0.2)
	end
end

function UIManager.CloseSettings()
	if settingsModalGroup then
		fadeCanvas(settingsModalGroup, 1, 0.2, function()
			settingsModalGroup.Visible = false
		end)
	end
end

function UIManager.ShowClassSelect()
	if LobbyCamera then
		pcall(function()
			LobbyCamera.SetClassSelectView()
		end)
	end

	if titleScreenGroup and classSelectGroup then
		fadeCanvas(titleScreenGroup, 1, 0.25, function()
			titleScreenGroup.Visible = false
			classSelectGroup.Visible = true
			fadeCanvas(classSelectGroup, 0, 0.25)
		end)
	end
end

function UIManager.FadeOutToGame(onComplete: (() -> ())?)
	local fadeOverlay = Instance.new("Frame")
	fadeOverlay.Name = "GameTransitionFade"
	fadeOverlay.Size = UDim2.new(1, 0, 1, 0)
	fadeOverlay.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	fadeOverlay.BackgroundTransparency = 1
	fadeOverlay.ZIndex = 999
	fadeOverlay.Parent = screenGui

	local fadeIn = TweenService:Create(fadeOverlay, TweenInfo.new(0.4, Enum.EasingStyle.Sine, Enum.EasingDirection.In), {
		BackgroundTransparency = 0,
	})

	fadeIn.Completed:Once(function()
		if titleScreenGroup then titleScreenGroup.Visible = false end
		if classSelectGroup then classSelectGroup.Visible = false end
		if settingsModalGroup then settingsModalGroup.Visible = false end

		if onComplete then
			onComplete()
		end

		task.wait(0.2)
		local fadeOut = TweenService:Create(fadeOverlay, TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
			BackgroundTransparency = 1,
		})
		fadeOut.Completed:Once(function()
			fadeOverlay:Destroy()
			screenGui.Enabled = false
		end)
		fadeOut:Play()
	end)

	fadeIn:Play()
end

return UIManager
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
</roblox>