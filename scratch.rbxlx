      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">Network</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local FOLDER_NAME = "NetworkRemotes"

local Network = {}

-- Predefined remote names
Network.Remotes = {
	SelectClass = "SelectClass",
	ClassConfirmed = "ClassConfirmed",
	SaveSettings = "SaveSettings",
	SpawnInChurch = "SpawnInChurch",
}

local function getFolder(): Folder
	local folder = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
	if not folder then
		if RunService:IsServer() then
			folder = Instance.new("Folder")
			folder.Name = FOLDER_NAME
			folder.Parent = ReplicatedStorage
		else
			folder = ReplicatedStorage:WaitForChild(FOLDER_NAME) :: Folder
		end
	end
	return folder :: Folder
end

-- Auto-create all remotes on server at load time
if RunService:IsServer() then
	local folder = getFolder()
	for _, remoteName in pairs(Network.Remotes) do
		if not folder:FindFirstChild(remoteName) then
			local remote = Instance.new("RemoteEvent")
			remote.Name = remoteName
			remote.Parent = folder
		end
	end
end

function Network.GetRemoteEvent(name: string): RemoteEvent
	local folder = getFolder()
	local remote = folder:FindFirstChild(name)
	if not remote then
		if RunService:IsServer() then
			remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		else
			remote = folder:WaitForChild(name) :: RemoteEvent
		end
	end
	return remote :: RemoteEvent
end

function Network.GetRemoteFunction(name: string): RemoteFunction
	local folder = getFolder()
	local remote = folder:FindFirstChild(name)
	if not remote then
		if RunService:IsServer() then
			remote = Instance.new("RemoteFunction")
			remote.Name = name
			remote.Parent = folder
		else
			remote = folder:WaitForChild(name) :: RemoteFunction
		end
	end
	return remote :: RemoteFunction
end

return Network
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">SettingsConfig</string>
          <string name="Source"><![CDATA[export type KeybindEntry = {
	action: string,
	displayName: string,
	category: string,
	defaultKey: string, -- e.g. "MouseButton1", "E", "Q", "F"
}

export type PlayerSettings = {
	masterVolume: number, -- 0 to 1
	musicVolume: number,  -- 0 to 1
	sfxVolume: number,    -- 0 to 1
	cameraShake: boolean,
	lowDetailVFX: boolean,
	damageNumbers: boolean,
	keybinds: { [string]: string }, -- actionName -> Enum.KeyCode name or UserInputType name
}

local DefaultKeybinds: { KeybindEntry } = {
	{ action = "PrimaryAttack", displayName = "Primary Attack", category = "Combat", defaultKey = "MouseButton1" },
	{ action = "Skill1", displayName = "Skill 1", category = "Combat", defaultKey = "E" },
	{ action = "Skill2", displayName = "Skill 2", category = "Combat", defaultKey = "R" },
	{ action = "Skill3", displayName = "Skill 3", category = "Combat", defaultKey = "C" },
	{ action = "Ultimate", displayName = "Ultimate Ability", category = "Combat", defaultKey = "F" },
	{ action = "Dash", displayName = "Dash / Evade", category = "Movement", defaultKey = "Q" },
	{ action = "Sprint", displayName = "Sprint", category = "Movement", defaultKey = "LeftShift" },
	{ action = "Interact", displayName = "Interact", category = "General", defaultKey = "V" },
	{ action = "OpenMenu", displayName = "Toggle Menu", category = "General", defaultKey = "M" },
}

local DefaultSettings: PlayerSettings = {
	masterVolume = 0.8,
	musicVolume = 0.6,
	sfxVolume = 0.9,
	cameraShake = true,
	lowDetailVFX = false,
	damageNumbers = true,
	keybinds = {
		["PrimaryAttack"] = "MouseButton1",
		["Skill1"] = "E",
		["Skill2"] = "R",
		["Skill3"] = "C",
		["Ultimate"] = "F",
		["Dash"] = "Q",
		["Sprint"] = "LeftShift",
		["Interact"] = "V",
		["OpenMenu"] = "M",
	},
}

local SettingsConfig = {}
SettingsConfig.DefaultSettings = DefaultSettings
SettingsConfig.DefaultKeybinds = DefaultKeybinds

function SettingsConfig.CloneDefaultSettings(): PlayerSettings
	local clone: PlayerSettings = {
		masterVolume = DefaultSettings.masterVolume,
		musicVolume = DefaultSettings.musicVolume,
		sfxVolume = DefaultSettings.sfxVolume,
		cameraShake = DefaultSettings.cameraShake,
		lowDetailVFX = DefaultSettings.lowDetailVFX,
		damageNumbers = DefaultSettings.damageNumbers,
		keybinds = {},
	}
	for action, key in pairs(DefaultSettings.keybinds) do
		clone.keybinds[action] = key
	end
	return clone
end

return SettingsConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">UITheme</string>
          <string name="Source"><![CDATA[local TweenService = game:GetService("TweenService")

local UITheme = {
	Colors = {
		Background = Color3.fromRGB(12, 14, 19),
		BackgroundOverlay = Color3.fromRGB(8, 10, 14),
		Surface = Color3.fromRGB(20, 23, 31),
		SurfaceAlt = Color3.fromRGB(28, 32, 44),
		SurfaceHover = Color3.fromRGB(36, 42, 58),
		SurfaceSelected = Color3.fromRGB(45, 52, 72),
		
		Border = Color3.fromRGB(52, 60, 80),
		BorderHover = Color3.fromRGB(100, 120, 165),
		BorderActive = Color3.fromRGB(235, 185, 75),
		
		Gold = Color3.fromRGB(235, 185, 75),
		GoldLight = Color3.fromRGB(255, 220, 115),
		GoldDark = Color3.fromRGB(170, 125, 35),
		
		TextPrimary = Color3.fromRGB(245, 248, 255),
		TextSecondary = Color3.fromRGB(165, 175, 195),
		TextMuted = Color3.fromRGB(100, 110, 130),
		
		Success = Color3.fromRGB(55, 215, 125),
		Danger = Color3.fromRGB(240, 70, 70),
		Info = Color3.fromRGB(70, 180, 255),
		Warning = Color3.fromRGB(250, 160, 45),
	},

	Fonts = {
		Title = Enum.Font.GothamBold,
		Header = Enum.Font.GothamBold,
		Body = Enum.Font.GothamMedium,
		Sub = Enum.Font.Gotham,
		Button = Enum.Font.GothamBold,
		Tag = Enum.Font.GothamBold,
	},

	Tweens = {
		Fast = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		Standard = TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
		Spring = TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
		SmoothFade = TweenInfo.new(0.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
	},
}

-- Utility Constructors
function UITheme.AddCorner(parent: Instance, radius: number): UICorner
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = parent
	return corner
end

function UITheme.AddStroke(parent: Instance, color: Color3, thickness: number?, transparency: number?): UIStroke
	local stroke = Instance.new("UIStroke")
	stroke.Color = color
	stroke.Thickness = thickness or 1
	stroke.Transparency = transparency or 0
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = parent
	return stroke
end

function UITheme.AddPadding(parent: Instance, top: number, bottom: number, left: number, right: number): UIPadding
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, top)
	pad.PaddingBottom = UDim.new(0, bottom)
	pad.PaddingLeft = UDim.new(0, left)
	pad.PaddingRight = UDim.new(0, right)
	pad.Parent = parent
	return pad
end

function UITheme.AddGradient(parent: Instance, c1: Color3, c2: Color3, rotation: number?): UIGradient
	local grad = Instance.new("UIGradient")
	grad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, c1),
		ColorSequenceKeypoint.new(1, c2),
	})
	grad.Rotation = rotation or 0
	grad.Parent = parent
	return grad
end

function UITheme.MakeButtonInteractive(
	button: GuiButton,
	stroke: UIStroke?,
	accentColor: Color3?,
	onHoverSound: (() -> ())?,
	onClickSound: (() -> ())?
)
	local normalColor = button.BackgroundColor3
	local normalScale = button.Size
	local normalStroke = stroke and stroke.Color or UITheme.Colors.Border
	local hoverStroke = accentColor or UITheme.Colors.Gold

	button.MouseEnter:Connect(function()
		if onHoverSound then onHoverSound() end
		TweenService:Create(button, UITheme.Tweens.Fast, {
			BackgroundColor3 = UITheme.Colors.SurfaceHover,
		}):Play()
		if stroke then
			TweenService:Create(stroke, UITheme.Tweens.Fast, {
				Color = hoverStroke,
				Transparency = 0,
			}):Play()
		end
	end)

	button.MouseLeave:Connect(function()
		TweenService:Create(button, UITheme.Tweens.Fast, {
			BackgroundColor3 = normalColor,
		}):Play()
		if stroke then
			TweenService:Create(stroke, UITheme.Tweens.Fast, {
				Color = normalStroke,
				Transparency = 0.2,
			}):Play()
		end
	end)

	button.MouseButton1Down:Connect(function()
		if onClickSound then onClickSound() end
		TweenService:Create(button, UITheme.Tweens.Fast, {
			Size = UDim2.new(normalScale.X.Scale, normalScale.X.Offset - 2, normalScale.Y.Scale, normalScale.Y.Offset - 2),
		}):Play()
	end)

	button.MouseButton1Up:Connect(function()
		TweenService:Create(button, UITheme.Tweens.Spring, {
			Size = normalScale,
		}):Play()
	end)
end

return UITheme
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
